# Pi Google Home — Server Configuration

# Network
SERVER_HOST=0.0.0.0
SERVER_PORT=8765

# Speech-to-Text (STT) — faster-whisper on NVIDIA GPU
WHISPER_MODEL=base.en
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# Text-to-Speech (TTS) — piper-tts
PIPER_MODEL=en_US-lessac-medium
PIPER_VOICE_DIR=server/tts/voices

# LLM / Reasoning Engine
# Options: gemini, ollama
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
